# Disaster Spatial Agent — environment template
# Copy to .env and fill in real values:  cp .env.example .env

# ── Required ──────────────────────────────────────────────────────
# LLM synthesis layer (OpenAI-compatible endpoint)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
MODEL=gpt-4o-mini

# USGS instantaneous values API (flood gauge observations).
# Public endpoint works without a key; set USGS_API_KEY if you have one.
USGS_WATER_API_URL=https://waterservices.usgs.gov/nwis/iv
USGS_API_KEY=

# Census API key (population exposure server) — request one at
# https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=

# ── Optional: Google Earth Engine (Sentinel-1 SAR flood extent) ───
# Service-account JSON key + matching email (see gee_flood_extent.py)
GEE_SERVICE_ACCOUNT_KEY_PATH=
GEE_SERVICE_ACCOUNT_EMAIL=

# ── Optional: NOAA/NWS contact (their API policy asks for a real
#    contact address in the User-Agent) ────────────────────────────
NWS_USER_AGENT=(disaster-agent, you@example.com)

# ── Optional: Overpass resilience (see mcp_servers/overpass_client.py) ──
# Hedged requests (serial first mirror, then concurrent failover),
# per-mirror cooldown, cross-process mirror-health sharing, and a TTL
# response cache are built in. Override mirror list:
# OSM_OVERPASS_ENDPOINTS=https://overpass-api.de/api/interpreter,https://overpass.kumi.systems/api/interpreter
# Cache TTL in seconds (0 disables; default 900):
# OSM_OVERPASS_TTL_SECONDS=900
# Cache directory (default <project>/cache/overpass):
# OSM_OVERPASS_CACHE_DIR=

# ── Optional tuning (defaults shown) ──────────────────────────────
HITL_ENABLED=true
HITL_TIMEOUT_SECONDS=120
VULNERABILITY_WEIGHT=1.0
EQUITY_HIGH_VULNERABILITY_THRESHOLD=0.90
# Binary coverage radius (km) for the equity ledger: a tract is covered
# when its centroid lies within R km of any allocation point. Small R
# keeps the Pareto frontier informative; large R blankets small cities
# and saturates VWUN at 0 (all plans cover all tracts).
# Code default is 10; 2 is the paper convention.
VULNERABILITY_COVERAGE_RADIUS_KM=2
SVI_RADIUS_KM=10
FLOOD_STATION_MAX_DISTANCE_KM=50
NWS_WARNING_RADIUS_KM=25

# ── SAR 实时窗口与跨维度矛盾告警（2026-08-31）────────────────
# Sentinel-1A 单星在德州实际重访 12 天；实时窗口默认 6 天（水位为
# 主证据，旧场景对"现在"无时效）。水位在岸内而卫星足迹 ≥ 此份额
# 时发 SAR_EXTENT_STAGE_CONTRADICTION 告警（不抬分）。
SENTINEL_REALTIME_MAX_AGE_DAYS=6
SAR_STAGE_CONTRADICTION_SHARE=0.05
SAR_MAX_PLAUSIBLE_SHARE=0.5
SAR_SUSPECT_DENSITY_PER_KM2=5
GIS_SEARCH_RADIUS_POI_KM=5
