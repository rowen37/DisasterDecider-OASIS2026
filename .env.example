# Disaster Spatial Agent — environment template
# Copy to .env and fill in real values:  cp .env.example .env

# ── Required ──────────────────────────────────────────────────────
# Application bind address. Keep localhost unless LAN access is intentional.
HOST=127.0.0.1
PORT=8000

# LLM synthesis layer (OpenAI-compatible endpoint). The offline demo and
# test suite do not need a key; live narrative synthesis does.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
MODEL=gpt-4o-mini

# USGS instantaneous values API (flood gauge observations).
# Public endpoint works without a key; set USGS_API_KEY if you have one.
USGS_WATER_API_URL=https://waterservices.usgs.gov/nwis/iv
USGS_API_KEY=

# Census API key (population exposure server) — request one at
# https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=

# ── Optional: Google Earth Engine (Sentinel-1 SAR flood extent) ───
# Service-account JSON key + matching email (see gee_flood_extent.py)
GEE_SERVICE_ACCOUNT_KEY_PATH=
GEE_SERVICE_ACCOUNT_EMAIL=

# ── Optional: NOAA/NWS contact (their API policy asks for a real
#    contact address in the User-Agent) ────────────────────────────
NWS_USER_AGENT=(disaster-agent, you@example.com)
NWS_WARNING_RADIUS_KM=25

# ── Optional: Overpass resilience (see mcp_servers/overpass_client.py) ──
# Hedged requests (serial first mirror, then concurrent failover),
# per-mirror cooldown, cross-process mirror-health sharing, and a TTL
# response cache are built in. Override mirror list:
OSM_OVERPASS_ENDPOINTS=https://maps.mail.ru/osm/tools/overpass/api/interpreter,https://overpass.private.coffee/api/interpreter,https://overpass.kumi.systems/api/interpreter,https://overpass-api.de/api/interpreter
# Cache TTL in seconds (0 disables; default 900):
# OSM_OVERPASS_TTL_SECONDS=900
# Cache directory (default <project>/cache/overpass):
# OSM_OVERPASS_CACHE_DIR=

# ── Optional tuning (defaults shown) ──────────────────────────────
HITL_ENABLED=true
HITL_TIMEOUT_SECONDS=120
AUTO_APPROVE_CONFIDENCE=0.7
HITL_PARAMETER_CHECKPOINT=true
VULNERABILITY_WEIGHT=1.0
EQUITY_HIGH_VULNERABILITY_THRESHOLD=0.90
# Binary coverage radius (km) for the equity ledger: a tract is covered
# when its centroid lies within R km of any allocation point. Small R
# keeps the Pareto frontier informative; large R blankets small cities
# and saturates VWUN at 0 (all plans cover all tracts).
# Code default is 10; 2 is the paper convention.
VULNERABILITY_COVERAGE_RADIUS_KM=2
SVI_RADIUS_KM=10
SVI_MAX_FEATURES=500
FLOOD_STATION_MAX_DISTANCE_KM=50
FUSION_CONFLICT_THRESHOLD_RATIO=0.5

# ── Live multi-source fusion and resource planning ───────────────
# Keep these as one-line JSON values in .env. They are not needed by the
# hermetic offline demo, which injects the same configuration temporarily.
FLOOD_FUSION_SOURCES_JSON=[{"name":"river_level","source_type":"hydrology","tool":"get_flood_observation","enabled":true,"arguments":{"station_id":"{station_id}","start_dt":"{event_start}","end_dt":"{event_end}"}},{"name":"weather","source_type":"weather","tool":"get_weather_observations","enabled":true,"arguments":{"latitude":"{latitude}","longitude":"{longitude}"}},{"name":"precipitation","source_type":"precipitation","tool":"get_precipitation","enabled":true,"arguments":{"latitude":"{latitude}","longitude":"{longitude}","hours":6}},{"name":"forecast","source_type":"forecast","tool":"get_forecast","enabled":true,"arguments":{"latitude":"{latitude}","longitude":"{longitude}","periods":7}},{"name":"flood_warnings","source_type":"warning","tool":"get_flood_warnings","enabled":true,"arguments":{"latitude":"{latitude}","longitude":"{longitude}","radius_km":"{warning_radius_km}"}},{"name":"population_exposure","source_type":"exposure","tool":"get_population_exposure","enabled":true,"arguments":{"latitude":"{latitude}","longitude":"{longitude}","radius_km":10}},{"name":"GEE Sentinel-1 Flood Extent","source_type":"satellite_sar","tool":"get_flood_extent","enabled":true,"arguments":{"latitude":"{latitude}","longitude":"{longitude}","observation_date":"{event_date}","buffer_km":"{flood_analysis_radius_km}","post_days":3,"return_geometry":true}},{"name":"critical_infrastructure","source_type":"infrastructure","tool":"get_critical_infrastructure","enabled":true,"arguments":{"latitude":"{latitude}","longitude":"{longitude}","radius_km":10}},{"name":"road_network","source_type":"road","tool":"get_road_status","enabled":true,"arguments":{"latitude":"{latitude}","longitude":"{longitude}","radius_km":10}}]
RESOURCE_DISCOVERY_TOOL=get_available_resources
RESOURCE_DISCOVERY_ARGUMENTS_JSON={"latitude":"{latitude}","longitude":"{longitude}","radius_km":30,"resource_type":"all","demand_population":"{affected_population}","water_level_ratio":"{water_level_ratio}"}
RESOURCE_ALLOCATION_OBJECTIVES_JSON=[{"name":"risk_reduction","direction":"maximize"},{"name":"coverage","direction":"maximize"},{"name":"response_time","direction":"minimize"},{"name":"cost","direction":"minimize"},{"name":"unmet_demand","direction":"minimize"}]
RESOURCE_OBJECTIVE_WEIGHTS_JSON={"risk_reduction":0.35,"coverage":0.25,"response_time":0.20,"cost":0.10,"unmet_demand":0.10}
RESOURCE_MAX_PLAN_COMBINATIONS=10000
SVI_TOOL=get_social_vulnerability

# ── SAR 实时窗口与跨维度矛盾告警（2026-08-31）────────────────
# Sentinel-1A 单星在德州实际重访 12 天；实时窗口默认 6 天（水位为
# 主证据，旧场景对"现在"无时效）。水位在岸内而卫星足迹 ≥ 此份额
# 时发 SAR_EXTENT_STAGE_CONTRADICTION 告警（不抬分）。
SENTINEL_REALTIME_MAX_AGE_DAYS=6
SAR_STAGE_CONTRADICTION_SHARE=0.05
SAR_MAX_PLAUSIBLE_SHARE=0.5
SAR_SUSPECT_DENSITY_PER_KM2=5

# ── 峰值水位与降雨佐证（2026-09-26，Lodi NJ 复盘）────────────
# 历史回放中事件水位 = 事件窗口内峰值（NWPS 等级定义在瞬时水位上；
# 窗口末端快照会错杀窗口内涨落的水灾，如 Lodi 2026-09-13）。
# 佐证判据（满足其一即可采纳卫星足迹为作业范围）：
#   1) 峰值水位 ≥ 官方 action stage（历史/实时均可）
#   2) 活跃 NWS 洪水警报（仅实时；历史回放跳过 current-only 源）
#   3) 观测强降雨 ≥ PRECIPITATION_CORROBORATION_MM（仅实时；
#      默认 25mm ≈ 1 inch/6h 量级的山洪指引值）
PRECIPITATION_CORROBORATION_MM=25

# ── 建模回退洪水范围（卫星缺失/过期时的 fail-loud 降级）───────
# 卫星范围不可用而已验证的峰值水位 ≥ action stage 时，用 OSM 河网
# × 超阈尺度的缓冲半径生成"建模范围"（地图/暴露/路径继续产出，
# 全程标注 modeled，绝不冒充观测淹没）。半径锚点（km）：
#   超阈 0 → STAGE_BUFFER_BASE_KM；到 minor → MINOR；到 moderate →
#   MODERATE；封顶 MAX。无 minor 锚点时退化为 base×(1+超阈英尺)。
STAGE_BUFFER_BASE_KM=0.15
STAGE_BUFFER_MINOR_KM=0.4
STAGE_BUFFER_MODERATE_KM=0.8
STAGE_BUFFER_MAX_KM=1.5
# 河网抓取半径（km，以测站为锚点）；测站只测一条河——只缓冲距测站
# 最近的 STAGE_BUFFER_MAX_WATERWAYS 条水道（干流+直接汇流），溪流
# （stream）半径乘 STAGE_BUFFER_STREAM_FRACTION。
WATERWAY_SEARCH_RADIUS_KM=15
STAGE_BUFFER_MAX_WATERWAYS=5
STAGE_BUFFER_STREAM_FRACTION=0.4

# ── GEE 观测窗前向扩展 ─────────────────────────────────────────
# 事件窗内无景时优先向未来扩窗（捕获事件后影像，仍在历史滞后容忍
# [-1, +6] 天内），找不到再向过去回扩。默认最多向前 7 天。
GEE_FORWARD_EXTENSION_DAYS=7
# Facility screening uses disclosed planning-time service areas rather than
# live traffic: 30 km/h × 30 min = 15 km primary; if empty, 60 min = 30 km.
GIS_FACILITY_PLANNING_SPEED_KMH=30
GIS_FACILITY_PRIMARY_SERVICE_MINUTES=30
GIS_FACILITY_EXTENDED_SERVICE_MINUTES=60
# OSM building inventory is queried only in grid cells intersecting the
# operational flood polygon. Large footprints automatically enlarge cells to
# stay under the tile cap; a partial tile set is never accepted as a count.
GIS_BUILDING_TILE_SIZE_KM=0.75
GIS_BUILDING_MAX_TILES=24
OSM_BUILDING_TILE_TOTAL_BUDGET_SECONDS=80
# OSM buildings change slowly; retain each successful tile for seven days.
OSM_BUILDING_TILE_CACHE_TTL_SECONDS=604800
# Route-network download is a corridor after a facility is selected; these
# half-widths do not alter the 15/30 km facility search above.
GIS_ROUTE_CORRIDOR_KM=2
GIS_ROUTE_EXPANDED_CORRIDOR_KM=4
OSM_ROUTE_REQUEST_TIMEOUT_SECONDS=20
OSM_ROUTE_MAX_DOWNLOAD_ATTEMPTS=2

# ── Capacity-constrained transfer planning ───────────────────────
EVACUATION_DESTINATION_TYPES=shelter,hospital
# Optional planning bounds. If either is blank, the system reports distance
# only and does not estimate transfer or clearance time.
EVACUATION_PLANNING_SPEED_MIN_KMH=
EVACUATION_PLANNING_SPEED_MAX_KMH=
# Optional verified local names/addresses keyed by OSM element (way/123 etc.).
OSM_LABEL_OVERRIDES_PATH=config/osm_label_overrides.json
# Optional replacement for the versioned static capability registry.
COMMUNITY_FACILITIES_PATH=config/community_facilities.json
